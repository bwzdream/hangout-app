# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: GIF search (free key at https://developers.giphy.com)
EXPO_PUBLIC_GIPHY_API_KEY=

# Visual theme: light (off-white, black, mint) or dark (black, acid green, neon pink)
EXPO_PUBLIC_THEME=light
